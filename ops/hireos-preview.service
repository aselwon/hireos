[Unit]
Description=HireOS MVP
After=network.target

[Service]
Type=simple
User=hireos
Group=hireos
WorkingDirectory=/opt/hireos/current
Environment=NODE_ENV=production
Environment=PORT=4317
Environment=HIREOS_DB=/var/lib/hireos/preview.sqlite
Environment=HIREOS_DATA_DIR=/var/lib/hireos
Environment=HIREOS_SECURE_COOKIE=1
EnvironmentFile=/etc/hireos/env
UMask=0077
ExecStart=/usr/bin/node --experimental-sqlite /opt/hireos/current/server.mjs
Restart=on-failure
RestartSec=5
StateDirectory=hireos
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hireos
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
