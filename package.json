{
  "name": "hireos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite server.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check lib/store.mjs && node --check hireos/dist/app.js",
    "quality:prepare": "qoq --warmup",
    "quality:check": "qoq --check --json",
    "quality:fix": "qoq --fix",
    "ci": "npm run quality:check && npm run check && npm test",
    "eval:generate": "node scripts/generate-cv-eval.mjs",
    "eval:cv": "node scripts/eval-cv.mjs"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "@ladamczyk/qoq-cli": "6.8.0",
    "@ladamczyk/qoq-eslint-v9-js": "6.8.0",
    "@ladamczyk/qoq-knip": "6.8.0",
    "@ladamczyk/qoq-prettier": "6.8.0"
  }
}
